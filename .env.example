# Kopieren nach .env und nur lokal verwenden.
# .env wird nicht versioniert. Die Werte unten sind Platzhalter
# für die eigene Entwicklungsumgebung.

POSTGRES_USER=braupartner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=braupartner

# Verbindung vom Host zum Datenbank-Container bzw. zu einem lokalen PostgreSQL.
# Passwörter in dieser URL müssen URL-sicher sein: Buchstaben, Ziffern und Bindestrich.
DATABASE_URL=postgresql+psycopg://braupartner:change-me@localhost:5432/braupartner

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
