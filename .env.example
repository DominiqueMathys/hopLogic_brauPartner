# Kopieren nach .env und nur lokal verwenden.
# .env wird nicht versioniert. Die Werte unten sind Platzhalter
# für die eigene Entwicklungsumgebung.

POSTGRES_USER=braupartner
POSTGRES_PASSWORD=change-me
POSTGRES_DB=braupartner

# Verbindung vom Host zum Datenbank-Container bzw. zu einem lokalen PostgreSQL.
# Passwörter in dieser URL müssen URL-sicher sein: Buchstaben, Ziffern und Bindestrich.
DATABASE_URL=postgresql+psycopg://braupartner:change-me@localhost:5432/braupartner

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Sitzungs-Cookie. Lokal über HTTP muss der Wert false bleiben, sonst sendet der Browser das Cookie nicht.
# Hinter HTTPS in einer späteren Bereitstellung auf true setzen. Das ist noch keine Produktionsfreigabe.
SESSION_COOKIE_SECURE=false

# Mock-ERP. Die Datei ist eine eigene Testdatenbank und keine Verbindung zum ERP des Brauhauses.
MOCK_ERP_PATH=data/mock-erp.sqlite
ERP_TIMEOUT_SECONDS=10
ERP_MAX_ATTEMPTS=3

# Platzhalter für einen späteren externen Connector. Leer lassen.
# Eine echte Verbindung braucht HTTPS, einen registrierten Connector und Zugangsdaten ausserhalb des Quellcodes.
# ERP_BASE_URL=
# ERP_CLIENT_ID=
# ERP_CLIENT_SECRET=
